---
import { Picture } from 'astro:assets';
import { CalendarDays, Newspaper } from 'lucide-react';
import { CATEGORY_LABELS, type NewsItem } from '@/lib/news';
import { formatDate, href, pick, type Lang } from '@/i18n';

interface Props {
  item: NewsItem;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { item, lang, headingLevel: H = 'h3' } = Astro.props;
---

<article data-reveal class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-sand bg-white shadow-float transition-shadow hover:shadow-lift">
  {item.image ? (
    <Picture
      src={item.image}
      formats={['avif', 'webp']}
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      alt=""
      class="aspect-[16/10] w-full object-cover"
    />
  ) : (
    <div class="bg-zellige flex aspect-[16/10] w-full items-center justify-center bg-emerald-50" aria-hidden="true">
      <Newspaper className="size-10 text-emerald-700/50" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-emerald-50 px-2.5 py-1 font-bold text-emerald-900">{pick(lang, CATEGORY_LABELS[item.category])}</span>
      <span class="flex items-center gap-1 text-muted">
        <CalendarDays className="size-3.5" aria-hidden="true" />
        <time datetime={item.date.slice(0, 10)}>{formatDate(item.date, lang)}</time>
      </span>
    </div>
    <H class="mt-3 line-clamp-3 text-base font-semibold leading-snug" lang={item.textLang} dir={item.textLang === 'ar' ? 'rtl' : 'ltr'}>
      <a href={href(lang, `news/${item.id}/`)} class="after:absolute after:inset-0 group-hover:underline">{item.headline}</a>
    </H>
  </div>
</article>
