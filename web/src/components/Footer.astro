---
import { Mail, Phone, MapPin, ShieldCheck } from 'lucide-react';
import { CONTACT, HELPLINES } from '@/data/site';
import { href, pick, useT, type Lang, type RouteKey } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();

const EXPLORE: RouteKey[] = ['about', 'rights', 'goals', 'programs', 'achievements', 'news'];
const GIVE: RouteKey[] = ['donate', 'trust', 'contact'];
---

<footer class="relative bg-emerald-950 text-emerald-50">
  <span class="flag-band absolute inset-x-0 top-0 h-1" aria-hidden="true"></span>
  <div class="bg-zellige-light">
    <div class="container-site grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <p class="font-sans text-2xl font-extrabold text-white" dir="ltr">{t.brandName}</p>
        <p class="mt-1 text-sm font-semibold text-emerald-100">{t.brandFull}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-emerald-50/80">{t.footer.about}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <h2 class="text-sm font-bold uppercase tracking-wide text-white">{t.footer.explore}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {EXPLORE.map((r) => <li><a class="text-emerald-50/80 hover:text-white hover:underline" href={href(lang, r)}>{t.nav[r]}</a></li>)}
        </ul>
      </nav>

      <nav aria-label={t.footer.give}>
        <h2 class="text-sm font-bold uppercase tracking-wide text-white">{t.footer.give}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {GIVE.map((r) => <li><a class="text-emerald-50/80 hover:text-white hover:underline" href={href(lang, r)}>{t.nav[r]}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-white">{t.footer.contact}</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-center gap-2.5">
            <Phone className="size-4 shrink-0 text-amber-accent" aria-hidden="true" />
            <a class="hover:underline" href={`tel:${CONTACT.phone}`} dir="ltr">{CONTACT.phoneDisplay}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail className="size-4 shrink-0 text-amber-accent" aria-hidden="true" />
            <a class="break-all hover:underline" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="size-4 shrink-0 text-amber-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 13.5h2.5l1-4H14v-2c0-1 .5-2 2-2h1.7V2.1A21 21 0 0 0 15.2 2C12.6 2 11 3.6 11 6.4v3.1H8v4h3V22h3v-8.5Z"/></svg>
            <a class="hover:underline" href={CONTACT.facebook} rel="noopener" target="_blank" dir="ltr">{CONTACT.facebookHandle}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <MapPin className="size-4 shrink-0 text-amber-accent" aria-hidden="true" />
            <span>{pick(lang, CONTACT.city)}</span>
          </li>
        </ul>
        <p class="mt-5 flex items-start gap-2.5 rounded-lg bg-white/5 p-3 text-xs leading-relaxed text-emerald-50/90">
          <ShieldCheck className="mt-0.5 size-4 shrink-0 text-amber-accent" aria-hidden="true" />
          <span>
            {t.footerHelpline}{' '}
            {HELPLINES.map((h, i) => (
              <>
                {i > 0 && ' · '}
                <a class="font-bold text-white hover:underline" href={`tel:${h.number}`} dir="ltr">{h.number}</a>
              </>
            ))}
          </span>
        </p>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="container-site flex flex-col gap-2 py-5 text-xs text-emerald-50/70 sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {t.brandFull} — {t.footer.rights}</p>
        <p>{t.footer.legal}</p>
      </div>
    </div>
  </div>
</footer>
