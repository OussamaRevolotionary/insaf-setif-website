---
import { Box, Maximize2 } from 'lucide-react';
import { asset, useT, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  /** File in /public, e.g. "timeline_of_progress.html". */
  file: string;
  title: string;
  sub?: string;
}
const { lang, file, title, sub } = Astro.props;
const t = useT(lang);
const src = asset(file);
---

<!-- The 3D scenes are full Three.js pages: they load only when the visitor asks. -->
<div class="relative overflow-hidden rounded-xl bg-emerald-950 shadow-lift" data-embed3d>
  <div class="bg-zellige-light flex aspect-[4/5] flex-col items-center justify-center gap-4 p-8 text-center sm:aspect-video" data-embed3d-poster>
    <Box className="size-12 text-amber-accent" aria-hidden="true" />
    <h2 class="text-2xl text-white sm:text-3xl">{title}</h2>
    {sub && <p class="max-w-md text-emerald-50/85">{sub}</p>}
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <button type="button" data-src={src} data-title={title} class="rounded-lg bg-white px-5 py-3 font-bold text-emerald-900 transition-colors hover:bg-emerald-50">
        {t.pages.view3d}
      </button>
      <a href={src} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-white/40 px-5 py-3 font-bold text-white hover:bg-white/10">
        <Maximize2 className="size-4" aria-hidden="true" />
        {t.pages.fullscreen}
      </a>
    </div>
    <p class="text-xs text-emerald-50/70">{t.pages.view3dNote}</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-embed3d]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('button[data-src]');
    btn?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = btn.dataset.src ?? '';
      frame.title = btn.dataset.title ?? '';
      frame.allowFullscreen = true;
      frame.style.cssText = 'display:block;width:100%;height:80vh;min-height:480px;border:0';
      box.replaceChildren(frame);
      frame.focus();
    });
  });
</script>
