---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import logo from '@/assets/brand/logo.jpg';
import { CONTACT, FOUNDED } from '@/data/site';
import { LOCALES, LANG_META, href, useT, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  /** Path after /<lang>/ (e.g. "donate/"), '' for home. */
  slug: string;
  title: string;
  description: string;
  /** Optimised image for social cards; defaults to the logo. */
  ogImage?: ImageMetadata;
  noindex?: boolean;
}

const { lang, slug, title, description, ogImage, noindex = false } = Astro.props;
const t = useT(lang);
const meta = LANG_META[lang];
const site = Astro.site!;

const abs = (path: string) => new URL(path, site).href;
const canonical = abs(href(lang, slug));
const og = await getImage({ src: ogImage ?? logo, width: 1200, format: 'jpg' });
const logoAbs = abs((await getImage({ src: logo, width: 512, format: 'png' })).src);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': abs(`${import.meta.env.BASE_URL}#org`),
  name: t.brandFull,
  alternateName: 'INSAF',
  url: abs(href(lang)),
  logo: logoAbs,
  foundingDate: `${FOUNDED.year}-${String(FOUNDED.month).padStart(2, '0')}`,
  email: CONTACT.email,
  telephone: CONTACT.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Sétif', addressCountry: 'DZ' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Sétif' },
  sameAs: [CONTACT.facebook],
};
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>if (document.visibilityState === 'visible' && 'IntersectionObserver' in window) document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(href(l, slug))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(href('ar', slug))} />
    <link rel="icon" href={logoAbs} type="image/png" />
    <link rel="sitemap" href={abs(`${import.meta.env.BASE_URL}sitemap-index.xml`)} />
    <meta name="theme-color" content="#0f392b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brandFull} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:locale" content={meta.og} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-emerald-900 focus:px-4 focus:py-3 focus:font-bold focus:text-white"
    >
      {t.skip}
    </a>
    <Header lang={lang} slug={slug} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Scroll reveals and count-up numbers, one observer for both.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const fmt = (n: number) => new Intl.NumberFormat('fr-FR').format(n).replace(/ | /g, ' ');
        if (reduce || !Number.isFinite(target)) return;
        const start = performance.now();
        const dur = 1600;
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          el.textContent = el.dataset.plain ? String(Math.round(target * (1 - Math.pow(1 - p, 3)))) : fmt(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const pending = new Set(document.querySelectorAll<HTMLElement>('[data-reveal], [data-count]'));
      const show = (el: HTMLElement) => {
        if (!pending.delete(el)) return;
        el.classList.add('is-in');
        if (el.dataset.count) countUp(el);
      };
      // Reveals are only armed (html.js) when the page loads visible with IntersectionObserver;
      // otherwise everything is shown as-is. The scroll check is a second safety net.
      const io = 'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => entries.forEach((e) => e.isIntersecting && (show(e.target as HTMLElement), io?.unobserve(e.target))),
            { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
          )
        : null;
      pending.forEach((el) => io?.observe(el));
      let queued = false;
      const check = () => {
        queued = false;
        const limit = (window.innerHeight || document.documentElement.clientHeight) * 0.92;
        pending.forEach((el) => el.getBoundingClientRect().top < limit && show(el));
        if (!pending.size) removeEventListener('scroll', onScroll);
      };
      const onScroll = () => { if (!queued) { queued = true; setTimeout(check, 60); } };
      addEventListener('scroll', onScroll, { passive: true });
      setTimeout(check, 400);
      if (!io) pending.forEach(show);
      addEventListener('beforeprint', () => pending.forEach(show));
    </script>
  </body>
</html>
