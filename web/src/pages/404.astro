---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOCALES, href, useT } from '@/i18n';

// GitHub Pages serves one 404 for every language, so it speaks all three.
const ar = useT('ar');
---

<BaseLayout lang="ar" slug="" title={`404 — ${ar.brandFull}`} description={ar.notFoundText} noindex>
  <section class="bg-zellige">
    <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-sans text-7xl font-extrabold text-emerald-900" dir="ltr">404</p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        {LOCALES.map((l) => {
          const t = useT(l);
          return (
            <li lang={l} dir={l === 'ar' ? 'rtl' : 'ltr'} class="rounded-xl border border-sand bg-white p-6 shadow-float">
              <p class="text-lg font-bold text-emerald-900">{t.notFoundText}</p>
              <a href={href(l)} class="mt-4 inline-block rounded-lg bg-emerald-900 px-4 py-2.5 font-bold text-white hover:bg-emerald-800">{t.notFoundBtn}</a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
