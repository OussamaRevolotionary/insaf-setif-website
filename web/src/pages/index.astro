---
// Root of the site: send visitors to their language, Arabic by default.
// Legacy hash links (#/donate, #/news …) from the old SPA — including the Chargily
// return URL "?donation=success#/donate" — are mapped to the same page in the new site.
import { href, ROUTES } from '@/i18n';
import { CONTENT_SECURITY_POLICY } from '@/data/site';
const ar = href('ar');
const fr = href('fr');
const en = href('en');
const slugs = Object.values(ROUTES).filter(Boolean).map((s) => s.replace(/\/$/, ''));
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CONTENT_SECURITY_POLICY} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>INSAF — جمعية إنصاف لولاية سطيف</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(ar, Astro.site).href} />
    <noscript><meta http-equiv="refresh" content={`0;url=${ar}`} /></noscript>
    <script is:inline define:vars={{ ar, fr, en, slugs }}>
      const homes = { ar, fr, en };
      const pref = (navigator.languages || [navigator.language || '']).map((l) => l.slice(0, 2).toLowerCase());
      const lang = pref.find((l) => l in homes) || 'ar';
      // "#/donate?campaign=school" → slug "donate", query "campaign=school"
      const m = location.hash.match(/^#\/([a-z-]*)\/?(?:\?(.*))?$/);
      const slug = m && slugs.includes(m[1]) ? m[1] + '/' : '';
      const query = new URLSearchParams(location.search);
      if (m && m[2]) new URLSearchParams(m[2]).forEach((v, k) => query.set(k, v));
      // the old site called the designation "campaign"
      if (query.has('campaign') && !query.has('designation')) {
        query.set('designation', query.get('campaign'));
        query.delete('campaign');
      }
      const qs = query.toString();
      location.replace(homes[lang] + slug + (qs ? '?' + qs : ''));
    </script>
  </head>
  <body>
    <p><a href={ar}>العربية</a> · <a href={fr}>Français</a> · <a href={en}>English</a></p>
  </body>
</html>
