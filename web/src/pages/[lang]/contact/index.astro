---
import { Mail, MapPin, Phone, ShieldCheck } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { CONTACT, CONTACT_WEBHOOK, HELPLINES } from '@/data/site';
import { langPaths, pick, useT, type Lang } from '@/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const c = t.contactPage;
const field = 'w-full rounded-lg border border-sand bg-white px-3 py-2.5 outline-none focus:ring-2 focus:ring-emerald-900 aria-invalid:border-flag-red';
---

<BaseLayout lang={lang} slug="contact/" title={t.seo.contact.title} description={t.seo.contact.description}>
  <PageHero kicker={c.kicker} title={t.nav.contact} lead={c.lead} />

  <section class="py-14 lg:py-20">
    <div class="container-site grid gap-8 lg:grid-cols-[1fr_1.4fr]">
      <aside class="space-y-4">
        <div class="rounded-xl border border-sand bg-white p-6">
          <h2 class="text-xl">{t.contactTitle}</h2>
          <ul class="mt-5 space-y-4 text-sm">
            <li class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-900"><Phone className="size-5" aria-hidden="true" /></span>
              <a href={`tel:${CONTACT.phone}`} class="font-semibold hover:underline" dir="ltr">{CONTACT.phoneDisplay}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-900"><Mail className="size-5" aria-hidden="true" /></span>
              <a href={`mailto:${CONTACT.email}`} class="break-all font-semibold hover:underline">{CONTACT.email}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-900">
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 13.5h2.5l1-4H14v-2c0-1 .5-2 2-2h1.7V2.1A21 21 0 0 0 15.2 2C12.6 2 11 3.6 11 6.4v3.1H8v4h3V22h3v-8.5Z" /></svg>
              </span>
              <a href={CONTACT.facebook} target="_blank" rel="noopener" class="font-semibold hover:underline" dir="ltr">{CONTACT.facebookHandle}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-900"><MapPin className="size-5" aria-hidden="true" /></span>
              <span class="font-semibold">{pick(lang, CONTACT.city)}</span>
            </li>
          </ul>
        </div>
        <p class="flex items-start gap-3 rounded-xl bg-flag-red/5 p-5 text-sm ring-1 ring-flag-red/20">
          <ShieldCheck className="mt-0.5 size-5 shrink-0 text-flag-red" aria-hidden="true" />
          <span>
            <strong>{t.footerHelpline}</strong>{' '}
            {HELPLINES.map((h, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`tel:${h.number}`} class="font-bold text-flag-red hover:underline" dir="ltr">{h.number}</a>
              </>
            ))}
          </span>
        </p>
      </aside>

      <form
        class="rounded-xl border border-sand bg-white p-6 shadow-float sm:p-8"
        novalidate
        data-contact-form
        data-endpoint={CONTACT_WEBHOOK}
        data-lang={lang}
        data-err-name={t.formErrName}
        data-err-email={t.formErrEmail}
        data-err-msg={t.formErrMsg}
        data-ok={t.formSuccess}
        data-fail={t.formError}
        data-sending={c.sending}
      >
        <h2 class="text-xl">{c.formTitle}</h2>
        <!-- Honeypot: hidden from people, filled by bots -->
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -start-[9999px] size-px opacity-0" />

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold">{t.formName}</span>
            <input name="name" autocomplete="name" maxlength="80" class:list={['mt-1', field]} aria-describedby="err-name" />
            <span id="err-name" class="mt-1 block text-xs font-semibold text-flag-red" data-error="name"></span>
          </label>
          <label class="block">
            <span class="text-sm font-semibold">{t.formEmail}</span>
            <input name="email" type="email" autocomplete="email" maxlength="120" dir="ltr" class:list={['mt-1', field]} aria-describedby="err-email" />
            <span id="err-email" class="mt-1 block text-xs font-semibold text-flag-red" data-error="email"></span>
          </label>
          <label class="block">
            <span class="text-sm font-semibold">{t.formOrg} <span class="font-normal text-muted">({t.optional})</span></span>
            <input name="org" maxlength="120" class:list={['mt-1', field]} />
          </label>
          <label class="block">
            <span class="text-sm font-semibold">{c.topicLabel}</span>
            <select name="topic" class:list={['mt-1', field]}>
              {Object.entries(c.topics).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label class="block sm:col-span-2">
            <span class="text-sm font-semibold">{t.formMsg}</span>
            <textarea name="message" rows="6" maxlength="4000" class:list={['mt-1', field]} aria-describedby="err-message"></textarea>
            <span id="err-message" class="mt-1 block text-xs font-semibold text-flag-red" data-error="message"></span>
          </label>
        </div>

        <button type="submit" class="mt-5 rounded-lg bg-emerald-900 px-6 py-3 font-bold text-white transition-colors hover:bg-emerald-800 disabled:opacity-60">{t.formSend}</button>
        <p class="mt-4 hidden rounded-lg p-3 text-sm font-semibold" role="status" data-status></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const d = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.textContent;
    const topics = [...form.topic.options].map((o: HTMLOptionElement) => o.value);
    const fromUrl = new URLSearchParams(location.search).get('topic');
    if (fromUrl && topics.includes(fromUrl)) form.topic.value = fromUrl;

    const show = (ok: boolean, msg: string) => {
      status.textContent = msg;
      status.className = `mt-4 rounded-lg p-3 text-sm font-semibold ${ok ? 'bg-emerald-50 text-emerald-900' : 'bg-flag-red/10 text-flag-red'}`;
    };
    const setError = (name: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      if (el) el.textContent = msg;
      form.elements.namedItem(name) instanceof HTMLElement && (form.elements.namedItem(name) as HTMLElement).setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.company_website) { form.reset(); show(true, d.ok ?? ''); return; }
      delete data.company_website;

      const errors: Record<string, string> = {
        name: data.name?.trim() ? '' : d.errName ?? '',
        email: /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email?.trim() ?? '') ? '' : d.errEmail ?? '',
        message: data.message?.trim() ? '' : d.errMsg ?? '',
      };
      Object.entries(errors).forEach(([k, v]) => setError(k, v));
      const first = Object.keys(errors).find((k) => errors[k]);
      if (first) { (form.elements.namedItem(first) as HTMLElement).focus(); return; }

      button.disabled = true;
      button.textContent = d.sending ?? '…';
      try {
        const res = await fetch(d.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, language: d.lang, source: 'website_contact_form', submittedAt: new Date().toISOString() }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.reset();
        show(true, d.ok ?? '');
      } catch {
        show(false, d.fail ?? '');
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
